{
  "uid": "driftless",
  "title": "Driftless",
  "description": "Postgres → Meilisearch sync: freshness, throughput, backpressure, and what it costs Postgres (T09).",
  "schemaVersion": 39,
  "editable": false,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Connector up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
      }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "up{job=\"driftless\"}" }]
    },
    {
      "id": 2, "type": "stat", "title": "Restarts in this time range",
      "description": "Each crash or kill restarts the process (fail-stop, D-009); it resumes from the slot.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "changes(driftless_process_start_time_seconds[$__range])", "instant": true }]
    },
    {
      "id": 3, "type": "stat", "title": "Lag p99, last 5 min",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(driftless_lag_seconds_bucket[5m])))" }]
    },
    {
      "id": 4, "type": "stat", "title": "WAL held for the slot",
      "description": "Postgres stops keeping WAL for the slot at 1 GB (max_slot_wal_keep_size, D-026).",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {
        "unit": "bytes",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 268435456 }, { "color": "red", "value": 805306368 }] }
      }, "overrides": [] },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "driftless_slot_retained_wal_bytes" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Lag: commit in Postgres → applied in Meilisearch",
      "description": "Until the transaction and everything before it are applied, i.e. until it may be confirmed.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(driftless_lag_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(driftless_lag_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Changes applied / s",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 20 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (op) (rate(driftless_changes_applied_total[$__rate_interval]))", "legendFormat": "{{op}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "One Meilisearch write (until it succeeded)",
      "description": "Most of the lag is this, about twice: a change waits for its lane's current write, then rides the next.",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(driftless_write_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(driftless_write_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Writes / s (all lanes)",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "wps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(driftless_batch_changes_count[$__rate_interval])", "legendFormat": "writes" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Changes per write (natural batching)",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(driftless_batch_changes_sum[$__rate_interval]) / rate(driftless_batch_changes_count[$__rate_interval])", "legendFormat": "average" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Changes waiting inside Driftless",
      "description": "Reading pauses at DRIFTLESS_MAX_PENDING and resumes at half (D-025).",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "driftless_changes_waiting", "legendFormat": "waiting" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "Transactions in flight",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "driftless_txns_in_flight", "legendFormat": "in flight" }]
    },
    {
      "id": 12, "type": "timeseries", "title": "Reading paused (backpressure)",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bool_on_off", "min": 0, "max": 1, "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 30 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "driftless_reading_paused", "legendFormat": "paused" }]
    },
    {
      "id": 13, "type": "timeseries", "title": "WAL held for the slot",
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "driftless_slot_retained_wal_bytes", "legendFormat": "retained" }]
    },
    {
      "id": 14, "type": "timeseries", "title": "WAL confirmed / s",
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(driftless_confirmed_lsn[$__rate_interval])", "legendFormat": "confirmed" }]
    },
    {
      "id": 15, "type": "timeseries", "title": "Connector memory",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "driftless_process_resident_memory_bytes", "legendFormat": "RSS" },
        { "refId": "B", "expr": "driftless_nodejs_heap_size_used_bytes", "legendFormat": "heap used" }
      ]
    }
  ]
}
