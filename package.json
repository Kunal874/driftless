    "meilisearch",
    "change-data-capture",
    "cdc",
    "logical-replication",
    "wal",
    "search",
    "sync",
    "typescript"
  ],
  "homepage": "https://github.com/Kunal874/driftless#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kunal874/driftless.git"
  },
  "bugs": {
    "url": "https://github.com/Kunal874/driftless/issues"
  },
  "author": "Kunal",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@redis/client": "6.3.0",
    "meilisearch": "^0.62.0",
    "pg": "^8.23.1",
    "pg-logical-replication": "2.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
